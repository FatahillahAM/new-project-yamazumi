{
  "version": 2,
  "framework": null,
  "installCommand": "composer install --no-dev --optimize-autoloader",
  "buildCommand": "echo 'skip'",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.2",
      "maxDuration": 300
    }
  },
  "routes": [{ "src": "/(.*)", "dest": "/api/index.php" }]
}